    },
    {
      "key": "host_ip",
      "type": "string",
      "default": null,
      "desc": "主机IP"
    },
    {
      "key": "cpus",
      "type": "number",
      "default": null,
      "desc": "CPU核心数限制"
    },
    {
      "key": "memory_limit",
      "type": "number",
      "default": null,
      "desc": "内存大小限制"
    },
    {
      "key": "app_port",
      "type": "port",
      "default": 8080,
      "desc": "应用端口"
    },
    {
      "key": "mysql_port",
      "type": "port",
      "default": 3307,
      "desc": "MySQL端口"
    },
    {
      "key": "redis_port",
      "type": "port",
      "default": 6380,
      "desc": "Redis端口"
    },
    {
      "key": "mysql_password",
      "type": "password",
      "default": null,
      "desc": "MySQL root密码"
    },
    {
      "key": "app_image_tag",
      "type": "string",
      "default": "1.0.3",
      "desc": "Docker Hub enc镜像tag"
    },
    {
      "key": "claim_base_url",
      "type": "url",
      "default": "https://install.zrlmeng.com",
