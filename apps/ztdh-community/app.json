  "reuse": true,
  "cpu": 2,
  "mem": 4096,
  "disk": 20480,
  "depend": null,
  "field": [
    {
      "attr": "domain",
      "name": "域名",
      "type": "textarea",
      "default": "",
      "suffix": "可选；安装后在网站反向代理绑定",
      "unit": ""
    },
    {
      "attr": "allow_access",
      "name": "允许外部访问",
      "type": "checkbox",
      "default": true,
      "suffix": "允许主机IP+端口访问；云服务器请放行安全组",
      "unit": ""
    },
    {
      "attr": "cpus",
      "name": "cpu核心数限制",
      "type": "number",
      "default": 0,
      "suffix": "0为不限制",
      "unit": ""
    },
    {
      "attr": "memory_limit",
      "name": "内存限制",
      "type": "number",
      "default": 0,
      "suffix": "0为不限制，单位MB；建议≥4096",
      "unit": ""
    },
    {
      "attr": "app_port",
      "name": "应用端口",
      "type": "number",
      "default": 8080,
      "suffix": "宿主机映射端口",
      "unit": ""
    },
    {
      "attr": "mysql_port",
      "name": "MySQL端口",
      "type": "number",
      "default": 3307,
      "suffix": "宿主机映射，避免与本机3306冲突",
      "unit": ""
    },
    {
      "attr": "redis_port",
      "name": "Redis端口",
      "type": "number",
      "default": 6380,
      "suffix": "宿主机映射，避免与本机6379冲突",
      "unit": ""
    },
    {
      "attr": "mysql_password",
      "name": "MySQL密码",
      "type": "password",
      "default": "",
      "suffix": "必填；请使用强密码",
      "unit": ""
    }
  ],
  "env": [
    {
      "key": "app_path",
      "type": "path",
      "default": null,
